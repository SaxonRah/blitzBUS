    if(next==head){++bb_v23_key_drop;return;}
    bb_v22_write_word(m,0x400u+tail,(uint16_t)(((uint16_t)bb_v23_scan(c)<<8)|c));
    bb_v22_write_word(m,0x41cu,next);
