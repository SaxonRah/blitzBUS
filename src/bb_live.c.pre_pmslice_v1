        bb_wd_on = 0;
    }
    if (bb_wd_on) {
        watchdog_hw->scratch[3] = (C.seg[B86_CS] << 16) | (C.ip & 0xFFFFu);
        watchdog_hw->scratch[1]++;
        watchdog_update();
    }
}
